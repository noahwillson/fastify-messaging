{
  "name": "fastify-messaging",
  "version": "1.3.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "RabbitMQ messaging for Fastify, Express and Node.js microservices",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "default": "./dist/core.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./dist/*.js": "./dist/*.js",
    "./dist/*": "./dist/*.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "core": [
        "dist/core.d.ts"
      ],
      "fastify": [
        "dist/fastify.d.ts"
      ],
      "express": [
        "dist/express.d.ts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "example:consumer": "ts-node examples/consumer-service.ts",
    "example:publisher": "ts-node examples/publisher-service.ts",
    "example:dlx": "ts-node examples/test-dlx.ts",
    "example:advanced-dlx": "ts-node examples/advanced-dlx.ts",
    "example:custom-exchanges": "ts-node examples/custom-exchanges.ts",
    "example:connection-resilience": "ts-node examples/connection-resilience.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.fastify4.json"
  },
  "keywords": [
    "fastify",
    "express",
    "nodejs",
    "messaging",
    "rabbitmq",
    "amqp",
    "events",
    "microservices",
    "pubsub",
    "retry",
    "dead-letter"
  ],
  "author": "Mohamed Sameh",
  "license": "MIT",
  "dependencies": {
    "amqplib": "^0.10.3",
    "fastify-plugin": "^4.5.1",
    "uuid": "^11.1.0"
  },
  "peerDependencies": {
    "express": "^4.0.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.28.1",
    "@types/amqplib": "^0.8.2",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/uuid": "^9.0.2",
    "express": "^5.2.1",
    "express4": "npm:express@^4.22.3",
    "fastify": "^5.12.5",
    "fastify4": "npm:fastify@^4.29.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6",
    "vitest": "^3.2.7"
  },
  "peerDependenciesMeta": {
    "fastify": {
      "optional": true
    },
    "express": {
      "optional": true
    }
  }
}
